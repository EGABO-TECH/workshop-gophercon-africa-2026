package components

import (
	"fmt"
	"strconv"
	"strings"
)

templ CompareSection(payload ComparePayload) {
	{{ statA := payload.Countries[payload.DefaultA] }}
	{{ statB := payload.Countries[payload.DefaultB] }}
	<section id="compare" class="section compare-section reveal" data-compare-root>
		<!-- Precomputed JSON dataset embedded for instant client-side swap & selection -->
		@templ.JSONScript("afritour-compare-data", payload)
		<div class="container section__header text-center">
			<div>
				<div class="section__eyebrow">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"></circle>
						<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
						<path d="M2 12h20"></path>
					</svg>
					Country comparison
				</div>
				<h2 class="section__title">Compare recorded <em class="editorial-em">observations</em></h2>
				<p class="section__subtitle max-w-2xl mx-auto">
					Compare species, observation and media counts for two countries in this archive.
				</p>
			</div>
		</div>
		<div class="container">
			<!-- Selector Toolbar -->
			<div class="versus-card">
				<form class="versus-form" id="versus-form" onsubmit="event.preventDefault();">
					<!-- Country A -->
					<div class="field-wrap">
						<label for="country-a-select" class="field-label">First country</label>
						<div class="select-box">
							<img id="flag-a" class="flag-icon" src={ fmt.Sprintf("https://flagcdn.com/w40/%s.png", flagCode(payload.DefaultA)) } alt="" width="24" height="18"/>
							<select id="country-a-select" class="versus-select" aria-label="Select first country">
								for _, c := range payload.CountryCodes {
									if c == payload.DefaultA {
										<option value={ c } selected>{ payload.Countries[c].Name } ({ strconv.Itoa(payload.Countries[c].Sightings) })</option>
									} else {
										<option value={ c }>{ payload.Countries[c].Name } ({ strconv.Itoa(payload.Countries[c].Sightings) })</option>
									}
								}
							</select>
						</div>
					</div>

					<!-- Swap Button -->
					<button type="button" id="versus-swap-btn" class="versus-swap" aria-label="Swap countries" title="Swap countries">
						<span class="versus-swap__text">vs</span>
						<svg class="versus-swap__icon" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 7h12m0 0-3-3m3 3-3 3M16 13H4m0 0 3-3m-3 3 3 3"></path>
						</svg>
					</button>

					<!-- Country B -->
					<div class="field-wrap">
						<label for="country-b-select" class="field-label">Second country</label>
						<div class="select-box">
							<img id="flag-b" class="flag-icon" src={ fmt.Sprintf("https://flagcdn.com/w40/%s.png", flagCode(payload.DefaultB)) } alt="" width="24" height="18"/>
							<select id="country-b-select" class="versus-select" aria-label="Select second country">
								for _, c := range payload.CountryCodes {
									if c == payload.DefaultB {
										<option value={ c } selected>{ payload.Countries[c].Name } ({ strconv.Itoa(payload.Countries[c].Sightings) })</option>
									} else {
										<option value={ c }>{ payload.Countries[c].Name } ({ strconv.Itoa(payload.Countries[c].Sightings) })</option>
									}
								}
							</select>
						</div>
					</div>
				</form>

				<!-- Verdict Banner -->
				<div class="verdict-banner" id="versus-verdict">
					<div class="verdict-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 19V5m0 14h17M8 15l4-4 3 2 5-6"></path>
							<path d="M16 7h4v4"></path>
						</svg>
					</div>
					<div class="verdict-text">
						<h3 class="verdict-title" id="verdict-title">Archive comparison</h3>
						<p class="verdict-note" id="verdict-note">Counts compare records currently available for the selected countries.</p>
					</div>
				</div>

				<!-- Round by Round Scorecard Table -->
				<div class="scoreboard-wrap">
					<table class="rounds-table" id="versus-table">
						<thead>
							<tr>
								<th scope="col" class="th-country-a">
									<img id="table-flag-a" class="flag-inline" src={ fmt.Sprintf("https://flagcdn.com/w40/%s.png", flagCode(payload.DefaultA)) } alt="" width="20" height="15"/>
									<span id="table-name-a">{ statA.Name }</span>
								</th>
								<th scope="col" class="th-round">Round Criteria</th>
								<th scope="col" class="th-country-b">
									<img id="table-flag-b" class="flag-inline" src={ fmt.Sprintf("https://flagcdn.com/w40/%s.png", flagCode(payload.DefaultB)) } alt="" width="20" height="15"/>
									<span id="table-name-b">{ statB.Name }</span>
								</th>
							</tr>
						</thead>
						<tbody>
							<tr id="row-species">
								<td class="score-cell cell-a" id="score-species-a">{ strconv.Itoa(statA.Species) }</td>
								<th scope="row" class="criteria-cell">
									<span class="criteria-title">Recorded species</span>
									<span class="criteria-sub">Distinct species in the archive</span>
								</th>
								<td class="score-cell cell-b" id="score-species-b">{ strconv.Itoa(statB.Species) }</td>
							</tr>
							<tr id="row-sightings">
								<td class="score-cell cell-a" id="score-sightings-a">{ strconv.Itoa(statA.Sightings) }</td>
								<th scope="row" class="criteria-cell">
									<span class="criteria-title">Observations</span>
									<span class="criteria-sub">Records in the archive</span>
								</th>
								<td class="score-cell cell-b" id="score-sightings-b">{ strconv.Itoa(statB.Sightings) }</td>
							</tr>
							<tr id="row-photos">
								<td class="score-cell cell-a" id="score-photos-a">{ strconv.Itoa(statA.Photos) }</td>
								<th scope="row" class="criteria-cell">
									<span class="criteria-title">Still images</span>
									<span class="criteria-sub">Still images in the archive</span>
								</th>
								<td class="score-cell cell-b" id="score-photos-b">{ strconv.Itoa(statB.Photos) }</td>
							</tr>
						</tbody>
					</table>
				</div>

				<!-- Side-by-Side Wildlife Breakdown -->
				<div class="versus-columns">
					<!-- Side A -->
					<div class="versus-side versus-side--left">
						<header class="versus-side__head">
							<h4 id="side-head-a">
								<img id="side-flag-a" class="flag-inline" src={ fmt.Sprintf("https://flagcdn.com/w40/%s.png", flagCode(payload.DefaultA)) } alt="" width="20" height="15"/>
								<span>{ statA.Name } observations</span>
							</h4>
							<p id="side-sub-a">{ strconv.Itoa(statA.Sightings) } sightings across { strconv.Itoa(statA.Species) } species</p>
						</header>
						<ol class="versus-side__list" id="side-list-a">
							for _, sp := range statA.TopWildlife {
								<li class="versus-row" data-name={ sp.Name }>
									if sp.PhotoURL != "" {
										<img src={ templ.URL(sp.PhotoURL) } alt={ sp.Name } class="versus-row__img" loading="lazy" decoding="async"/>
									} else {
										<div class="versus-row__img-fallback">🐾</div>
									}
									<span class="versus-row__name">{ sp.Name }</span>
									<span class="versus-row__bar-wrap">
										<span class="versus-row__bar" style={ fmt.Sprintf("width: %d%%", calcBarPercent(sp.Count, statA.TopWildlife)) }></span>
									</span>
									<span class="versus-row__count">{ strconv.Itoa(sp.Count) }</span>
								</li>
							}
						</ol>
					</div>

					<!-- Middle Chips: Shared Wildlife -->
					<div class="versus-middle" id="versus-middle">
						<div class="versus-middle__badge">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="18" cy="5" r="3"></circle>
								<circle cx="6" cy="12" r="3"></circle>
								<circle cx="18" cy="19" r="3"></circle>
								<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
								<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
							</svg>
							<span id="shared-count-label">Shared Wildlife</span>
						</div>
						<p class="versus-middle__hint">Select an animal to inspect shared distribution:</p>
						<div class="chips-wrap" id="shared-chips">
							<!-- Filled dynamically by JavaScript -->
						</div>
					</div>

					<!-- Side B -->
					<div class="versus-side versus-side--right">
						<header class="versus-side__head">
							<h4 id="side-head-b">
								<img id="side-flag-b" class="flag-inline" src={ fmt.Sprintf("https://flagcdn.com/w40/%s.png", flagCode(payload.DefaultB)) } alt="" width="20" height="15"/>
								<span>{ statB.Name } observations</span>
							</h4>
							<p id="side-sub-b">{ strconv.Itoa(statB.Sightings) } sightings across { strconv.Itoa(statB.Species) } species</p>
						</header>
						<ol class="versus-side__list" id="side-list-b">
							for _, sp := range statB.TopWildlife {
								<li class="versus-row" data-name={ sp.Name }>
									if sp.PhotoURL != "" {
										<img src={ templ.URL(sp.PhotoURL) } alt={ sp.Name } class="versus-row__img" loading="lazy" decoding="async"/>
									} else {
										<div class="versus-row__img-fallback">🐾</div>
									}
									<span class="versus-row__name">{ sp.Name }</span>
									<span class="versus-row__bar-wrap">
										<span class="versus-row__bar" style={ fmt.Sprintf("width: %d%%", calcBarPercent(sp.Count, statB.TopWildlife)) }></span>
									</span>
									<span class="versus-row__count">{ strconv.Itoa(sp.Count) }</span>
								</li>
							}
						</ol>
					</div>
				</div>
			</div>
		</div>
	</section>
}

func flagCode(code string) string {
	c := strings.ToLower(code)
	if c == "" {
		return "ke"
	}
	return c
}

func calcBarPercent(count int, list []SpeciesTally) int {
	if len(list) == 0 {
		return 100
	}
	max := list[0].Count
	if max <= 0 {
		return 100
	}
	pct := (count * 100) / max
	if pct < 15 {
		pct = 15
	}
	return pct
}
