package components

import (
	"cmp"
	"strings"
	"workshop/internal/domain/sighting"
)

templ Gallery(items []sighting.Media) {
	{{ media := availableMedia(items) }}
	if len(media) == 0 {
		<div class="gallery__empty-card">
			<svg class="gallery__empty-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
				<circle cx="12" cy="13" r="4"></circle>
			</svg>
			<span class="gallery__empty-text">No media available for this record</span>
		</div>
	} else {
		<ul class={ "gallery", galleryLayout(len(media)) }>
			for i, m := range media {
				if i < 3 {
					<li class="gallery__item">
						if m.Type == "StillImage" {
							<a href={ templ.URL(m.URL) } data-lightbox data-caption={ cmp.Or(m.Creator, altText(m)) } class="gallery__link" title="Click to view high-resolution photo">
								<img src={ templ.URL(m.URL) } alt={ altText(m) } loading="lazy" decoding="async"/>
								<span class="gallery__zoom-badge" aria-hidden="true">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="11" cy="11" r="8"></circle>
										<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
										<line x1="11" y1="8" x2="11" y2="14"></line>
										<line x1="8" y1="11" x2="14" y2="11"></line>
									</svg>
								</span>
							</a>
						} else {
							<a href={ templ.URL(m.URL) } target="_blank" rel="noopener" class="gallery__external-link">{ altText(m) } ↗</a>
						}
						if m.Creator != "" {
							<span class="gallery__credit">Photo: { m.Creator }</span>
						}
					</li>
				}
			}
		</ul>
	}
}

func altText(m sighting.Media) string {
	return cmp.Or(m.Title, m.Description, "Wildlife observation photo")
}

func availableMedia(items []sighting.Media) []sighting.Media {
	available := make([]sighting.Media, 0, len(items))
	for _, item := range items {
		if strings.TrimSpace(item.URL) != "" {
			available = append(available, item)
		}
	}
	return available
}

func galleryLayout(count int) string {
	switch {
	case count == 1:
		return "gallery--single"
	case count == 2:
		return "gallery--double"
	default:
		return "gallery--triple"
	}
}
