package components

type DestinationInfo struct {
	ID          string
	Name        string
	Country     string
	CountryCode string
	Tagline     string
	Description string
	BestSeason  string
	Wildlife    []string
	ImageURL    string
	IdealDays   string
	Highlights  string
}

func curatedDestinations() []DestinationInfo {
	return []DestinationInfo{
		{
			ID:          "serengeti",
			Name:        "Serengeti & Ngorongoro",
			Country:     "Tanzania",
			CountryCode: "TZ",
			Tagline:     "The Great Migration & Endless Savannas",
			Description: "Witness millions of wildebeest and zebras thundering across golden savannas, stalked by apex lion prides and cheetahs in Africa's most storied ecosystem.",
			BestSeason:  "Jul – Oct (Migration) · Jan – Mar (Calving)",
			Wildlife:    []string{"Lion", "Leopard", "Cheetah", "Wildebeest", "Elephant"},
			ImageURL:    "https://inaturalist-open-data.s3.amazonaws.com/photos/733089137/medium.jpg",
			IdealDays:   "5–8 Days",
			Highlights:  "Mara River crossings, Ngorongoro Crater floor, Olduvai Gorge",
		},
		{
			ID:          "masai-mara",
			Name:        "Masai Mara & Amboseli",
			Country:     "Kenya",
			CountryCode: "KE",
			Tagline:     "Big Cat Capital & Kilimanjaro Vistas",
			Description: "Sweeping acacia plains, dense populations of cheetahs and black-maned lions, juxtaposed with Amboseli's giant elephant herds under Mount Kilimanjaro.",
			BestSeason:  "Jul – Nov (Prime Game Viewing)",
			Wildlife:    []string{"Cheetah", "Lion", "Giraffe", "Elephant", "Hippo"},
			ImageURL:    "https://inaturalist-open-data.s3.amazonaws.com/photos/734736654/medium.jpg",
			IdealDays:   "4–7 Days",
			Highlights:  "Maasai community conservancies, hot air balloon safaris",
		},
		{
			ID:          "kruger",
			Name:        "Greater Kruger & Sabi Sands",
			Country:     "South Africa",
			CountryCode: "ZA",
			Tagline:     "Unrivaled Big Five & Luxury Safari Lodges",
			Description: "The gold standard of African wildlife hospitality. Renowned for intimate leopard encounters, private wilderness traversing, and night game drives.",
			BestSeason:  "May – Sep (Dry Winter Season)",
			Wildlife:    []string{"White Rhinoceros", "Leopard", "African Buffalo", "Wild Dog"},
			ImageURL:    "https://inaturalist-open-data.s3.amazonaws.com/photos/735321232/medium.jpg",
			IdealDays:   "4–6 Days",
			Highlights:  "Off-road tracking, walking safaris, luxury bush villas",
		},
		{
			ID:          "okavango",
			Name:        "Okavango Delta & Chobe",
			Country:     "Botswana",
			CountryCode: "BW",
			Tagline:     "Untamed Water Wilderness & Elephant Paradise",
			Description: "A crystal-clear inland oasis in the Kalahari desert. Glide through papyrus channels on wooden mokoros and track wild dog packs on private islands.",
			BestSeason:  "Jun – Oct (Peak Flood Waters)",
			Wildlife:    []string{"African Wild Dog", "Hippo", "Elephant", "Red Lechwe"},
			ImageURL:    "https://inaturalist-open-data.s3.amazonaws.com/photos/720373093/medium.jpg",
			IdealDays:   "5–7 Days",
			Highlights:  "Traditional mokoro trails, scenic helicopter fly-overs",
		},
		{
			ID:          "volcanoes",
			Name:        "Volcanoes & Bwindi Forest",
			Country:     "Rwanda & Uganda",
			CountryCode: "RW",
			Tagline:     "Mountain Gorilla & Rainforest Primate Haven",
			Description: "Ascend mist-veiled emerald slopes of the Virunga volcanoes for a life-altering hour in the company of gentle silverback mountain gorillas.",
			BestSeason:  "Jun – Sep & Dec – Feb",
			Wildlife:    []string{"Mountain Gorilla", "Chimpanzee", "Golden Monkey"},
			ImageURL:    "https://inaturalist-open-data.s3.amazonaws.com/photos/679988268/medium.jpg",
			IdealDays:   "3–5 Days",
			Highlights:  "Silverback habituated groups, primate sanctuary walks",
		},
		{
			ID:          "victoria-falls",
			Name:        "Victoria Falls & Zambezi",
			Country:     "Zambia & Zimbabwe",
			CountryCode: "ZW",
			Tagline:     "The Smoke That Thunders & Sunset River Safari",
			Description: "One of the Seven Natural Wonders of the World. Combine dramatic waterfall spray with tranquil Zambezi river cruises and elephant corridor walks.",
			BestSeason:  "Feb – May (High Water) · Aug – Dec (Devil's Pool)",
			Wildlife:    []string{"Nile Crocodile", "Hippo", "African Buffalo", "Fish Eagle"},
			ImageURL:    "https://inaturalist-open-data.s3.amazonaws.com/photos/689181863/medium.jpg",
			IdealDays:   "3–4 Days",
			Highlights:  "Helicopter Flight of Angels, Zambezi sunset cruises",
		},
	}
}

templ DestinationsSection() {
	<section id="destinations" class="section destinations-section reveal">
		<div class="container section__header">
			<div>
				<div class="section__eyebrow">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					Curated Itineraries & Sanctuaries
				</div>
				<h2 class="section__title">Iconic African Safari <em class="editorial-em">Destinations</em></h2>
				<p class="section__subtitle max-w-2xl">
					Handcrafted by African travel specialists. Explore Africa’s most pristine ecosystems, each matched with seasonal wildlife movements and verified biodiversity records.
				</p>
			</div>
			<div class="section__actions">
				<button type="button" class="btn btn--gold-outline" onclick="document.getElementById('planner-modal').showModal()">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
					</svg>
					Safari Matchmaker Quiz
				</button>
			</div>
		</div>

		<div class="container">
			<!-- Experience Category Pills -->
			<div class="safari-styles-bar">
				<span class="safari-styles-label">Safari Styles:</span>
				<div class="safari-styles-pills">
					<button type="button" class="style-pill is-active" data-style-filter="all">All Styles</button>
					<button type="button" class="style-pill" data-style-filter="big5">🦁 Big Five Classic</button>
					<button type="button" class="style-pill" data-style-filter="migration">🦓 Great Migration</button>
					<button type="button" class="style-pill" data-style-filter="gorilla">🦍 Primate Trekking</button>
					<button type="button" class="style-pill" data-style-filter="luxury">🚁 Fly-In Luxury</button>
					<button type="button" class="style-pill" data-style-filter="water">🛶 Water & Delta</button>
				</div>
			</div>

			<!-- Destination Cards Grid -->
			<div class="destinations-grid">
				for _, d := range curatedDestinations() {
					<article class="dest-card" data-country={ d.CountryCode } data-dest-id={ d.ID }>
						<div class="dest-card__media">
							<img src={ d.ImageURL } alt={ d.Name } class="dest-card__img" loading="lazy"/>
							<div class="dest-card__badge-row">
								<span class="dest-card__badge dest-card__badge--country">
									<img src={ "https://flagcdn.com/w40/" + flagCode(d.CountryCode) + ".png" } alt="" class="flag-micro" width="16" height="12"/>
									{ d.Country }
								</span>
								<span class="dest-card__badge dest-card__badge--days">{ d.IdealDays }</span>
							</div>
						</div>
						<div class="dest-card__body">
							<h3 class="dest-card__title">{ d.Name }</h3>
							<p class="dest-card__tagline">{ d.Tagline }</p>
							<p class="dest-card__desc">{ d.Description }</p>
							
							<div class="dest-card__details">
								<div class="detail-row">
									<span class="detail-label">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
											<line x1="16" y1="2" x2="16" y2="6"></line>
											<line x1="8" y1="2" x2="8" y2="6"></line>
											<line x1="3" y1="10" x2="21" y2="10"></line>
										</svg>
										Best Season:
									</span>
									<span class="detail-val">{ d.BestSeason }</span>
								</div>
								<div class="detail-row">
									<span class="detail-label">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
										</svg>
										Key Sighting:
									</span>
									<div class="wildlife-mini-chips">
										for _, w := range d.Wildlife {
											<span class="mini-chip">{ w }</span>
										}
									</div>
								</div>
							</div>

							<div class="dest-card__footer">
								<button type="button" class="btn btn--sm btn--gold-subtle" onclick={ filterByDestination(d.CountryCode) }>
									<span>Filter Field Sightings</span>
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="9 18 15 12 9 6"></polyline>
									</svg>
								</button>
								<button type="button" class="btn-wishlist-icon" aria-label="Save destination to wishlist" onclick={ toggleWishlistDest(d.Name, d.Country, d.ImageURL) }>
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
									</svg>
								</button>
							</div>
						</div>
					</article>
				}
			</div>
		</div>
	</section>
}

script filterByDestination(countryCode string) {
	const sel = document.querySelector('select[name="country"]');
	if (sel) {
		sel.value = countryCode;
		sel.dispatchEvent(new Event('input', { bubbles: true }));
		sel.dispatchEvent(new Event('change', { bubbles: true }));
	}
	const target = document.getElementById('sightings');
	if (target) {
		target.scrollIntoView({ behavior: 'smooth' });
	}
}

script toggleWishlistDest(title string, country string, img string) {
	if (window.AfriTourWishlist) {
		window.AfriTourWishlist.toggle({
			id: 'dest-' + encodeURIComponent(title),
			title: title,
			location: country,
			type: 'Destination',
			img: img
		});
	}
}
