package pages

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Trends(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	{{ byYear := sighting.CountByYear(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Record trends",
		Description: "Summaries of recorded wildlife observations by year, species and country.",
		CurrentPage: "trends",
	}) {
		<section class="section analytics-section archive-page">
			<div class="container section__header">
				<div>
					<div class="section__eyebrow">04 / ARCHIVE SUMMARY</div>
					<h1 class="section__title">Records over <em class="editorial-em">time</em></h1>
					if sum.Sightings > 0 {
						<p class="section__subtitle">A summary of recorded observations from { strconv.Itoa(sum.Earliest.Year()) } through { strconv.Itoa(sum.Latest.Year()) }.</p>
					} else {
						<p class="section__subtitle">Trends will appear when observations are available.</p>
					}
				</div>
				<a class="archive-page__back" href="/">← Archive home</a>
			</div>
			if len(sightings) > 0 {
				<div class="container">
					<div class="analytics-grid">
						<div class="analytics-card analytics-card--wide">
							<div class="analytics-card__header">
								<h2>Observation timeline</h2>
								<span class="analytics-card__badge">{ strconv.Itoa(sum.Sightings) } Total Records</span>
							</div>
							<p class="analytics-card__desc">Recorded observations by year.</p>
							@components.Sparkline(byYear, sum)
							<div class="analytics-card__footer">
								<span>Earliest: { sum.Earliest.Format("02 Jan 2006") }</span>
								<span>Latest: { sum.Latest.Format("02 Jan 2006") }</span>
							</div>
						</div>
						<div class="analytics-card">
							<div class="analytics-card__header">
								<h2>Most recorded species</h2>
								<span class="analytics-card__badge">Top 5</span>
							</div>
							@components.Bars(topSpecies(sightings, 5))
						</div>
						<div class="analytics-card">
							<div class="analytics-card__header">
								<h2>Countries with most records</h2>
								<span class="analytics-card__badge">Top 5</span>
							</div>
							@components.Bars(topCountries(sightings, 5))
						</div>
					</div>
				</div>
			} else {
				<div class="container">
					<div class="empty-state">
						<h2>The archive is quiet</h2>
						<p>Record trends will appear when observations are available.</p>
					</div>
				</div>
			}
		</section>
	}
}
