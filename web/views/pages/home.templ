package pages

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Wildlife field archive",
		Description: "Explore wildlife observations, field photographs, locations and trends from the AfriTour archive.",
		CurrentPage: "home",
	}) {
		<section id="hero" class="field-hero">
			<img class="field-hero__image" src="/assets/images/hero-forest.jpg" alt="Sunlight falling through a dense rainforest canopy" fetchpriority="high"/>
			<div class="field-hero__shade" aria-hidden="true"></div>
			<div class="field-hero__frame">
				<div class="field-hero__index">
					<span>AFRITOUR</span>
					<span>FIELD ARCHIVE <i>01</i></span>
				</div>
				<div class="field-hero__content">
					<p class="field-hero__eyebrow">FIELD NOTES · 01</p>
					<h1>Wildlife,<br/><em>in the field.</em></h1>
					<p class="field-hero__intro">A living record of the species, places and people behind each observation.</p>
					<div class="field-hero__links">
						<a href="/records" class="field-hero__primary">
							<span>Browse records</span>
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
								<path d="M4 12h15M13 5l7 7-7 7"/>
							</svg>
						</a>
						<a href="/map" class="field-hero__secondary">Explore the map</a>
					</div>
				</div>
				<div class="field-hero__stats" aria-label="Archive summary">
					<div>
						<strong>{ strconv.Itoa(sum.Sightings) }</strong>
						<span>Records</span>
					</div>
					<div>
						<strong>{ strconv.Itoa(sum.Species) }</strong>
						<span>Species</span>
					</div>
					<div>
						<strong>{ strconv.Itoa(sum.Countries) }</strong>
						<span>Countries</span>
					</div>
					<div>
						<strong>{ strconv.Itoa(sum.Media) }</strong>
						<span>Media items</span>
					</div>
				</div>
				<p class="field-hero__image-note"><span>01 /</span> Rainforest canopy</p>
			</div>
		</section>

		<section class="section archive-portal">
			<div class="container section__header">
				<div>
					<div class="section__eyebrow">EXPLORE THE ARCHIVE</div>
					<h2 class="section__title">Four ways into the <em class="editorial-em">field</em></h2>
					<p class="section__subtitle">Each collection has its own page. Choose a view to begin exploring.</p>
				</div>
			</div>
			<nav class="container portal-grid" aria-label="Explore the wildlife archive">
				<a class="portal-card" href="/photos">
					<span class="portal-card__index">01 / MEDIA</span>
					<strong>Photographs</strong>
					<span>Browse images attached to observations.</span>
					<span class="portal-card__arrow" aria-hidden="true">↗</span>
				</a>
				<a class="portal-card" href="/records">
					<span class="portal-card__index">02 / OBSERVATIONS</span>
					<strong>Records</strong>
					<span>Search species, locations and observers.</span>
					<span class="portal-card__arrow" aria-hidden="true">↗</span>
				</a>
				<a class="portal-card" href="/map">
					<span class="portal-card__index">03 / LOCATIONS</span>
					<strong>Map</strong>
					<span>See where observations were recorded.</span>
					<span class="portal-card__arrow" aria-hidden="true">↗</span>
				</a>
				<a class="portal-card" href="/trends">
					<span class="portal-card__index">04 / SUMMARY</span>
					<strong>Trends</strong>
					<span>Compare records across years and species.</span>
					<span class="portal-card__arrow" aria-hidden="true">↗</span>
				</a>
			</nav>
		</section>
	}
}
