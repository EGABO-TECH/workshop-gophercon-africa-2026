package pages

import (
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	{{ byYear := sighting.CountByYear(sightings) }}
	{{ photoHighlights := withPhotos(sightings, 12) }}
	{{ comparePayload := components.BuildComparePayload(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Wildlife field archive",
		Description: "Explore wildlife observations, field photographs, locations and trends from the AfriTour archive.",
	}) {
		<section id="hero" class="field-hero">
			<img class="field-hero__image" src="/assets/images/hero-forest.jpg" alt="Sunlight falling through a dense rainforest canopy" fetchpriority="high"/>
			<div class="field-hero__shade" aria-hidden="true"></div>
			<div class="field-hero__frame">
				<div class="field-hero__index">
					<span>AFRITOUR</span>
					<span>FIELD ARCHIVE <i>01</i></span>
				</div>
				<div class="field-hero__content">
					<p class="field-hero__eyebrow">FIELD NOTES · 01</p>
					<h1>Wildlife,<br/><em>in the field.</em></h1>
					<p class="field-hero__intro">A living record of the species, places and people behind each observation.</p>
					<div class="field-hero__links">
						<a href="#sightings" class="field-hero__primary">
							<span>Browse observations</span>
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
								<path d="M4 12h15M13 5l7 7-7 7"/>
							</svg>
						</a>
						<a href="#map-section" class="field-hero__secondary">Explore the map</a>
					</div>
				</div>
				<div class="field-hero__stats" aria-label="Archive summary">
					<div>
						<strong>{ strconv.Itoa(sum.Sightings) }</strong>
						<span>Records</span>
					</div>
					<div>
						<strong>{ strconv.Itoa(sum.Species) }</strong>
						<span>Species</span>
					</div>
					<div>
						<strong>{ strconv.Itoa(sum.Countries) }</strong>
						<span>Countries</span>
					</div>
					<div>
						<strong>{ strconv.Itoa(sum.Media) }</strong>
						<span>Media items</span>
					</div>
				</div>
				<p class="field-hero__image-note"><span>01 /</span> Rainforest canopy</p>
			</div>
		</section>

		<section id="highlights" class="section highlights reveal">
			<div class="container section__header">
				<div>
					<div class="section__eyebrow">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
							<circle cx="8.5" cy="8.5" r="1.5"></circle>
							<polyline points="21 15 16 10 5 21"></polyline>
						</svg>
						Field photographs
					</div>
					<h2 class="section__title">Selected <em class="editorial-em">observations</em></h2>
					<p class="section__subtitle">Photographs attached to records in the archive.</p>
				</div>
				<div class="section__actions">
					<span class="section__hint">Swipe to explore →</span>
				</div>
			</div>
			if len(photoHighlights) > 0 {
				<div class="highlights__slider-wrap">
					@components.Swiper(components.SwiperProps{DesktopSlides: 3, Dark: true}) {
						for _, s := range photoHighlights {
							<div class="swiper-slide">
								@components.SightingCard(s)
							</div>
						}
					}
				</div>
			} else {
				<div class="container">
					<p class="section__subtitle">No photographs are attached to the current records.</p>
				</div>
			}
		</section>

		<!-- Sightings Catalog & Filter Section -->
		<section id="sightings" class="section sightings-section reveal">
			<div class="container section__header">
				<div>
					<div class="section__eyebrow">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
						</svg>
						Observation archive
					</div>
					<h2 class="section__title">Wildlife <em class="editorial-em">records</em></h2>
					<p class="section__subtitle">Filter records by species or country, or search by observer and species name.</p>
				</div>
			</div>
			<div class="container">
				@components.Filter(components.FilterProps{
					Target: "sightings-list",
					Search: true,
					Groups: []components.FilterGroup{
						{
							Key:     "animal",
							Label:   "Species",
							Options: components.FilterOptions(sightings, 10, components.Animal),
						},
						{
							Key:     "country",
							Label:   "Countries",
							Options: components.FilterOptions(sightings, 8, components.Country),
						},
					},
				})
				if len(sightings) == 0 {
					<div class="empty-state">
						<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="8" y1="12" x2="16" y2="12"></line>
						</svg>
						<h3>No observations in the archive</h3>
						<p>Records will appear here when they are available.</p>
					</div>
				} else {
					<ul id="sightings-list" class="sightings-grid">
						for _, s := range sightings {
							<li class="sightings-grid__item" { components.FilterAttrs(s)... }>
								@components.SightingCard(s)
							</li>
						}
					</ul>
				}
			</div>
		</section>

		<section id="map-section" class="section map-section reveal">
			<div class="container section__header">
				<div>
					<div class="section__eyebrow">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
							<line x1="8" y1="2" x2="8" y2="18"></line>
							<line x1="16" y1="6" x2="16" y2="22"></line>
						</svg>
						Across the archive
					</div>
					<h2 class="section__title">Observations on the <em class="editorial-em">map</em></h2>
					<p class="section__subtitle">Browse recorded locations. Select a marker to see its observation details.</p>
				</div>
			</div>
			<div class="container">
				<div class="map-card">
					@components.Map(components.MapProps{
						Points:  components.MapPoints(sightings),
						Cluster: true,
						Label:   "Wildlife observation map",
						Class:   "map--dark",
					})
				</div>
			</div>
		</section>

		if len(sightings) > 0 {
			<section id="analytics" class="section analytics-section reveal">
			<div class="container section__header">
				<div>
					<div class="section__eyebrow">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="18" y1="20" x2="18" y2="10"></line>
							<line x1="12" y1="20" x2="12" y2="4"></line>
							<line x1="6" y1="20" x2="6" y2="14"></line>
						</svg>
						Archive summary
					</div>
						<h2 class="section__title">Records over <em class="editorial-em">time</em></h2>
					<p class="section__subtitle">A summary of recorded observations from { strconv.Itoa(sum.Earliest.Year()) } through { strconv.Itoa(sum.Latest.Year()) }.</p>
				</div>
			</div>
			<div class="container">
				<div class="analytics-grid">
					<!-- Timeline Card -->
					<div class="analytics-card analytics-card--wide">
						<div class="analytics-card__header">
							<h3>Observation Timeline</h3>
							<span class="analytics-card__badge">{ strconv.Itoa(sum.Sightings) } Total Records</span>
						</div>
						<p class="analytics-card__desc">Recorded observations by year.</p>
						@components.Sparkline(byYear, sum)
						<div class="analytics-card__footer">
							<span>Earliest: { sum.Earliest.Format("02 Jan 2006") }</span>
							<span>Latest: { sum.Latest.Format("02 Jan 2006") }</span>
						</div>
					</div>
					<!-- Species Leaderboard -->
					<div class="analytics-card">
						<div class="analytics-card__header">
							<h3>Most recorded species</h3>
							<span class="analytics-card__badge">Top 5</span>
						</div>
						@components.Bars(topSpecies(sightings, 5))
					</div>
					<!-- Territories Leaderboard -->
					<div class="analytics-card">
						<div class="analytics-card__header">
							<h3>Countries with most records</h3>
							<span class="analytics-card__badge">Top 5</span>
						</div>
						@components.Bars(topCountries(sightings, 5))
					</div>
				</div>
			</div>
			</section>
		} else {
			<section id="analytics" class="section analytics-section reveal">
				<div class="container">
					<div class="empty-state">
						<h2 class="section__title">The archive is <em class="editorial-em">quiet</em></h2>
						<p class="section__subtitle">Record trends will appear when observations are available.</p>
					</div>
				</div>
			</section>
		}

		if len(sightings) > 0 {
			@components.CompareSection(comparePayload)
		}

	}
}
