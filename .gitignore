# macOS
.DS_Store
._*

# Editor / IDE
.vscode/
.idea/
*.swp
*~
.venv/

# Local build output and incomplete downloads
/afritour.exe
assets/*.crdownload

# Skill mirrors provisioned by local AI coding tools
/.agents/skills/
/.augment/skills/
/.codebuddy/skills/
/.codex/skills/
/.continue/skills/
/.cursor/skills/
/.factory/skills/
/.gemini/skills/
/.github/prompts/
/.kilocode/skills/
/.kiro/steering/
/.opencode/skills/
/.qoder/skills/
/.roo/skills/
/.trae/skills/
/.warp/skills/
/.windsurf/skills/

# Environment / secrets
.env
.env.*
!.env.example

# Claude Code: the API key make key saves must never reach a commit
**/.claude/settings.local.json
__pycache__/

# Test and profiling output
coverage.*
*.out
*.pprof

# The database you build on the day is committed, so the instructor can run your
# site; SQLite's journals and any other database are not.
*.db
*.db-journal
*.db-wal
*.db-shm
!/workshop.db

# Build output
bin/*

# Vendored modules are committed whole: the patterns above are about your files, and
# would drop ones the build needs (golang.org/x/text has a coverage.go).
!/vendor/**
!/tools/gopls/vendor/**
